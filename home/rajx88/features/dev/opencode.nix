{
  pkgs,
  lib,
  config,
  ...
}:
let
  # radar's daemon only exists where features/dev/radar.nix is imported (yuji).
  # akarnae has no radar package, so no remote MCP entry there.
  hasRadar = lib.any (p: p ? pname && p.pname == "radar") config.home.packages;
in
{
  # OpenCode config owned by Nix. Modules contribute fragments here (e.g.
  # switchyard's provider) and it is rendered to overrides.json, which opencode
  # merges on top of the tool-managed opencode.json via OPENCODE_CONFIG. Keeping
  # everything Nix-owned out of opencode.json means tooling (codegraph install or
  # others) can freely write to opencode.json as an overlay.
  options.opencodeOverrides = lib.mkOption {
    type = lib.types.attrs;
    default = { };
    description = "OpenCode configuration owned by Nix, written to overrides.json and merged over opencode.json via OPENCODE_CONFIG.";
  };

  config = {
    # enable installs the package but declares no settings, so opencode.json is
    # NOT generated by Nix and stays a plain file tools can write to.
    programs.opencode = {
      enable = true;
      package = pkgs.opencode;
    };

    # Base Nix-owned config. The codegraph MCP lives here so enabling codegraph in
    # the Nix config is enough to wire it — no need to run `codegraph install`.
    opencodeOverrides = {
      "$schema" = "https://opencode.ai/config.json";
      default_agent = "plan";
      # Nix owns the binary, so never let opencode self-update.
      update = "disable";
      # v2 nests servers under mcp.servers and uses `disabled` (inverse of v1
      # `enabled`); servers connect by default when `disabled` is absent.
      mcp.servers = {
        codegraph = {
          type = "local";
          command = [
            "codegraph"
            "serve"
            "--mcp"
          ];
          disabled = false;
          # v2 routes MCP tools through Code Mode by default, which hides them
          # from the native tool list (only reachable as tools.<server>.* inside
          # `execute`). That is why agents kept grepping instead of using
          # codegraph_explore. `codegraph install` writes this flag for exactly
          # this reason (codegraph #1698); we hand-wire the entry, so set it here.
          codemode = false;
        };
      }
      // lib.optionalAttrs hasRadar {
        radar = {
          type = "remote";
          url = "http://localhost:9280/mcp";
        };
      };
      # v2 uses one ordered permissions array; the last matching rule wins.
      # v1 `bash` action is now `shell`.
      permissions = [
        {
          action = "shell";
          resource = "rm *";
          effect = "ask";
        }
        {
          action = "external_directory";
          resource = "${config.xdg.configHome}/opencode/*";
          effect = "allow";
        }
        {
          action = "external_directory";
          resource = "/tmp/*";
          effect = "allow";
        }
        {
          action = "external_directory";
          resource = "${config.home.homeDirectory}/code/*";
          effect = "allow";
        }
      ];
    };

    xdg.configFile."opencode/overrides.json".text = builtins.toJSON config.opencodeOverrides;

    home.sessionVariables.OPENCODE_CONFIG = "$HOME/.config/opencode/overrides.json";

    # Shared agent state (~/.hindsight, ~/.agents, the skills CLI registry) is
    # persisted in features/dev/coding-agents.nix — not tied to this harness.
    home.persistence."/persist".directories = [
      ".local/share/opencode"
      ".local/state/opencode"
      ".config/opencode"
    ];
  };
}
